{
  "name": "midnight-app",
  "version": "1.0.0",
  "type": "module",
  "description": "A Midnight Network application created with create-mn-app",
  "author": "",
  "license": "MIT",
  "scripts": {
    "compile": "wsl -d Ubuntu bash -l -c \"rm -rf ~/compact-temp && mkdir -p ~/compact-temp/contracts && cp '/mnt/s/midnight-level1-new-moon/contracts/hello-world.compact' ~/compact-temp/contracts/ && cd ~/compact-temp && compact compile contracts/hello-world.compact contracts/managed/hello-world && rm -rf '/mnt/s/midnight-level1-new-moon/contracts/managed' && cp -r contracts/managed '/mnt/s/midnight-level1-new-moon/contracts/' && rm -rf '/mnt/s/midnight-level1-new-moon/public/managed' && mkdir -p '/mnt/s/midnight-level1-new-moon/public/managed' && cp -r contracts/managed/hello-world '/mnt/s/midnight-level1-new-moon/public/managed/'\"",
    "build": "npx tsc --noEmit || true",
    "setup": "npx tsx src/setup.ts",
    "deploy": "npx tsx src/deploy.ts",
    "cli": "npx tsx src/cli.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed .midnight-state.json .midnight-wallet-state",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "dev": "vite",
    "build:web": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^5.4.10",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-wasm": "^3.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy"
  ]
}
